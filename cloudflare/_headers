/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# pages: always check for a new version (so a deploy shows up without clearing the browser cache)
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/*.html
  Cache-Control: no-cache
/pos-app/
  Cache-Control: no-cache
/pos-app/index.html
  Cache-Control: no-cache

# built files have their content hash in the name: keep them a year
/assets/*
  Cache-Control: public, max-age=31536000, immutable
